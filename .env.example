# The site's public address. Used for QR codes (slideshow, table cards) and link previews.
SITE_URL=https://nobletxnancy.com

# Set to true to allow ?mode=day and ?mode=after previews of the homepage in production.
# Leave unset on the live site so the date always decides.
ALLOW_MODE_PREVIEW=

# Postgres. These are the local docker compose values (docker compose up -d db).
# Production values live in Dokploy.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nona
POSTGRES_USER=nona
POSTGRES_PASSWORD=nona

# Confirmation emails (Resend). Without RESEND_API_KEY, development only logs the email.
RESEND_API_KEY=
EMAIL_FROM=
# Replies go to every address listed. Separate several addresses with commas.
EMAIL_REPLY_TO=
