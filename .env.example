# The site's public address. Used for QR codes (slideshow, table cards) and link previews.
SITE_URL=https://nobletxnancy.com

# Set to true to allow ?mode=day and ?mode=after previews of the homepage in production.
# Leave unset on the live site so the date always decides.
ALLOW_MODE_PREVIEW=

# Postgres. These are the local docker compose values (docker compose up -d db).
# Production values live in Dokploy.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nona
POSTGRES_USER=nona
POSTGRES_PASSWORD=nona

# Guest photos and videos: Cloudflare R2, through its S3 API. The private bucket holds the originals
# and manifests, the public one the thumbnails and viewing copies, served from MEDIA_BASE_URL.
# These are the local docker compose MinIO's values, with MinIO's well-known default keys
# (docker compose up -d minio, then npm run storage:init). Production values live in Dokploy.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PRIVATE_BUCKET=nona-private
R2_PUBLIC_BUCKET=nona-public
MEDIA_BASE_URL=http://localhost:9000/nona-public

# Signs the guest cookie that recognises each guest's browser (their uploads and personal link).
# At least 32 random bytes, for example from `openssl rand -base64 32`. Required in production, where
# its value lives in Dokploy; leave it empty locally and development and tests use a fixed dev-only one.
# Changing it forgets every browser's guests (their personal links still bring them back).
GUEST_COOKIE_SECRET=

# Confirmation emails (Resend). Without RESEND_API_KEY, development only logs the email.
RESEND_API_KEY=
EMAIL_FROM=
# Replies go to every address listed. Separate several addresses with commas.
EMAIL_REPLY_TO=

# Admin (/admin). Cloudflare Access sits in front of it and sends a signed token that the app verifies itself.
# Both are required in production, otherwise the admin refuses everyone.
# CF_ACCESS_TEAM_DOMAIN is a bare host like <team>.cloudflareaccess.com, without https://.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# The couple's sign-in emails, separated by commas: everything in the admin. Anyone else Access lets in
# gets in only as a viewer the couple added in the admin (People), who can read and download the
# Replies list and change nothing. Unset, everyone Access lets in who isn't a viewer is the couple.
ADMIN_COUPLE_EMAILS=
# Local development only: stands in for the signed-in admin. Ignored in production.
ADMIN_DEV_EMAIL=

# The media worker purges a hidden item's public files from Cloudflare's cache by URL. An API token
# allowed only "Zone · Cache Purge" on the site's zone, and that zone's id. Both are required in
# production, where a purge without them fails its job (retried until they are set); leave them
# empty locally, and purges are skipped. Their values live in Dokploy only.
CF_PURGE_TOKEN=
CF_ZONE_ID=

# The venue TV's delay: a new photo or video reaches /slideshow only this many seconds after it
# appears in the album, so the couple can hide anything first. Whole seconds, 0 to 900; 180 when
# unset. The admin's Photos page overrides it once the couple save a delay there.
SLIDESHOW_DELAY_SECONDS=180

# The home page's venue map (Google Maps). A browser key restricted by referrer (the site's domain and
# http://localhost:3000/*) and to the Maps JavaScript API only. Read when the page is served; without
# it the map shows Google's keyless satellite embed of the church instead. Its production value lives
# in Dokploy.
GOOGLE_MAPS_BROWSER_KEY=
